{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHarness",
  "version": "0.1.0",
  "identifier": "com.openharness.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenHarness",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: ipc: http://ipc.localhost; img-src 'self' https://huggingface.co https://cdn-avatars.huggingface.co data: tauri: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src 'self' https://huggingface.co tauri: ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline' tauri:; script-src 'self' 'unsafe-eval' 'unsafe-inline' tauri:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/OpenHarness/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "OpenHarness",
    "copyright": "Copyright (c) 2026",
    "resources": ["worker-py"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": "https://huggingface\\.co/.*"
    }
  }
}
